<%- include('partials/header') %>

  <div style="background: #FFE8D6; padding: 24px 0; border-bottom: 1px solid var(--border-color);">
    <div class="container" style="text-align: center;">
      <h1 style="font-size: 32px; color: var(--primary); margin-bottom: 6px;">Menu Pilihan NACHOAN</h1>
      <p style="color: var(--text-muted); font-size: 15px;">Nikmati kerenyahan pizza cone tortilla khas NACHOAN dengan
        bahan berkualitas!</p>
    </div>
  </div>

  <main class="section">
    <div class="container">
      <%
        const activeNachos = products.filter(x => x.category_id === 1 && x.available === 1 && !x.archived);
        const activeSnacks = products.filter(x => x.category_id === 2 && x.available === 1 && !x.archived);
        const activeDrinks = products.filter(x => x.category_id === 3 && x.available === 1 && !x.archived);
        const activeBundlingProds = products.filter(x => x.category_id === 4 && x.available === 1 && !x.archived);
        const activeBundles = (typeof bundles !== 'undefined' && Array.isArray(bundles)) ? bundles.filter(b => b.available === 1 && !b.archived) : [];
        const hasOtherCat = products.filter(x => ![1, 2, 3, 4, 5].includes(x.category_id) && x.available === 1 && !x.archived);
        const mainSeries = [...activeNachos, ...hasOtherCat];
      %>

      <!-- Category Filter Tabs -->
      <div
        style="display: flex; gap: 10px; overflow-x: auto; padding-bottom: 16px; margin-bottom: 24px; scrollbar-width: none;"
        id="category-tabs" role="tablist" aria-label="Filter Kategori Menu">
        <button type="button" class="btn btn-primary btn-sm cat-btn active" data-cat="all" role="tab" aria-selected="true">Semua Menu</button>
        <button type="button" class="btn btn-outline btn-sm cat-btn" data-cat="nachos" role="tab" aria-selected="false">Nachoan Series</button>
        <% if (activeSnacks.length > 0) { %>
          <button type="button" class="btn btn-outline btn-sm cat-btn" data-cat="snacks" role="tab" aria-selected="false">Snacks</button>
        <% } %>
        <button type="button" class="btn btn-outline btn-sm cat-btn" data-cat="bundling" role="tab" aria-selected="false">Bundling</button>
        <button type="button" class="btn btn-outline btn-sm cat-btn" data-cat="drinks" role="tab" aria-selected="false">Minuman</button>
      </div>

      <!-- Nachoan Series Category -->
      <div class="cat-section" id="cat-nachos" style="margin-bottom: 40px;">
        <h2
          style="font-size: 24px; color: var(--text-dark); margin-bottom: 16px; display: flex; align-items: center; gap: 8px;">
          Nachoan Series
        </h2>
        <div class="product-grid" style="grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));">
          <% for (const p of mainSeries) { %>
            <div class="product-card" data-cat="nachos">
              <span class="badge badge-red card-badge">MENU UTAMA</span>
              <a href="/product/<%= p.slug %>" class="product-thumb">
                <img src="<%= p.image %>" alt="<%= p.name %>" loading="lazy">
              </a>
              <div class="product-info">
                <h3 class="product-name">
                  <a href="/product/<%= p.slug %>"><%= p.name %></a>
                </h3>
                <p class="product-desc"><%= p.description %></p>
                <div class="product-footer">
                  <div class="product-price"><%= formatRupiah(p.price) %></div>
                  <div style="display: flex; gap: 8px;">
                    <a href="/product/<%= p.slug %>" class="btn btn-outline btn-sm">Detail</a>
                    <button type="button" class="btn btn-primary btn-sm"
                      onclick="Cart.add({ id: <%= p.id %>, type: 'product', name: '<%= p.name.replace(/'/g, "\\'") %>', price: <%= p.price %>, quantity: 1, image: '<%= p.image %>' })">
                      + Tambah
                    </button>
                  </div>
                </div>
              </div>
            </div>
          <% } %>
        </div>
      </div>

      <% if (activeSnacks.length > 0) { %>
      <!-- Snacks Category -->
      <div class="cat-section" id="cat-snacks" style="margin-bottom: 40px;">
        <h2 style="font-size: 24px; color: var(--text-dark); margin-bottom: 16px;">Snacks</h2>
        <div class="product-grid" style="grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));">
          <% for (const p of activeSnacks) { %>
            <div class="product-card" data-cat="snacks">
              <span class="badge badge-orange card-badge">SNACKS</span>
              <a href="/product/<%= p.slug %>" class="product-thumb">
                <img src="<%= p.image %>" alt="<%= p.name %>" loading="lazy">
              </a>
              <div class="product-info">
                <h3 class="product-name"><a href="/product/<%= p.slug %>"><%= p.name %></a></h3>
                <p class="product-desc"><%= p.description %></p>
                <div class="product-footer">
                  <div class="product-price"><%= formatRupiah(p.price) %></div>
                  <div style="display: flex; gap: 8px;">
                    <a href="/product/<%= p.slug %>" class="btn btn-outline btn-sm">Detail</a>
                    <button type="button" class="btn btn-primary btn-sm"
                      onclick="Cart.add({ id: <%= p.id %>, type: 'product', name: '<%= p.name.replace(/'/g, "\\'") %>', price: <%= p.price %>, quantity: 1, image: '<%= p.image %>' })">
                      + Tambah
                    </button>
                  </div>
                </div>
              </div>
            </div>
          <% } %>
        </div>
      </div>
      <% } %>

      <!-- Bundling Category -->
      <div class="cat-section" id="cat-bundling" style="margin-bottom: 40px;">
        <h2
          style="font-size: 24px; color: var(--text-dark); margin-bottom: 16px; display: flex; align-items: center; gap: 8px;">
          🍿 Paket Bundling & Combo
        </h2>
        <% if (activeBundles.length > 0 || activeBundlingProds.length > 0) { %>
          <div class="product-grid" style="grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));">
            <% for (const b of activeBundles) { %>
              <div class="product-card" data-cat="bundling">
                <span class="badge badge-yellow card-badge">COMBO HEMAT</span>
                <a href="/bundle/<%= b.slug %>" class="product-thumb">
                  <img src="<%= b.image %>" alt="<%= b.name %>" loading="lazy">
                </a>
                <div class="product-info">
                  <h3 class="product-name"><a href="/bundle/<%= b.slug %>"><%= b.name %></a></h3>
                  <p class="product-desc"><%= b.description %></p>
                  <div class="product-footer">
                    <div class="product-price"><%= formatRupiah(b.price) %></div>
                    <div style="display: flex; gap: 8px;">
                      <a href="/bundle/<%= b.slug %>" class="btn btn-outline btn-sm">Detail</a>
                      <button type="button" class="btn btn-primary btn-sm"
                        onclick="Cart.add({ id: <%= b.id %>, type: 'bundle', name: '<%= b.name.replace(/'/g, "\\'") %>', price: <%= b.price %>, quantity: 1, image: '<%= b.image %>' })">
                        + Tambah
                      </button>
                    </div>
                  </div>
                </div>
              </div>
            <% } %>
            <% for (const p of activeBundlingProds) { %>
              <div class="product-card" data-cat="bundling">
                <span class="badge badge-yellow card-badge">BUNDLING</span>
                <a href="/product/<%= p.slug %>" class="product-thumb">
                  <img src="<%= p.image %>" alt="<%= p.name %>" loading="lazy">
                </a>
                <div class="product-info">
                  <h3 class="product-name"><a href="/product/<%= p.slug %>"><%= p.name %></a></h3>
                  <p class="product-desc"><%= p.description %></p>
                  <div class="product-footer">
                    <div class="product-price"><%= formatRupiah(p.price) %></div>
                    <div style="display: flex; gap: 8px;">
                      <a href="/product/<%= p.slug %>" class="btn btn-outline btn-sm">Detail</a>
                      <button type="button" class="btn btn-primary btn-sm"
                        onclick="Cart.add({ id: <%= p.id %>, type: 'product', name: '<%= p.name.replace(/'/g, "\\'") %>', price: <%= p.price %>, quantity: 1, image: '<%= p.image %>' })">
                      + Tambah
                      </button>
                    </div>
                  </div>
                </div>
              </div>
            <% } %>
          </div>
        <% } else { %>
          <div class="card"
            style="text-align: center; padding: 40px 20px; background: #FFF8F0; border: 1.5px dashed var(--border-color);">
            <div style="font-size: 48px; margin-bottom: 12px;">🍿✨</div>
            <span class="badge badge-yellow" style="font-size: 13px; margin-bottom: 10px;">COMING SOON</span>
            <h3 style="font-size: 22px; color: var(--text-dark); margin-bottom: 8px;">Paket Bundling Segera Hadir!</h3>
            <p style="color: var(--text-muted); font-size: 14px; max-width: 450px; margin: 0 auto;">
              Kami sedang menyiapkan paket combo hemat khusus dengan paduan pizza cone favorit dan minuman pelengkap untuk
              Anda. Nantikan peluncurannya!
            </p>
          </div>
        <% } %>
      </div>

      <!-- Drinks Category -->
      <div class="cat-section" id="cat-drinks" style="margin-bottom: 40px;">
        <h2
          style="font-size: 24px; color: var(--text-dark); margin-bottom: 16px; display: flex; align-items: center; gap: 8px;">
          🥤 Minuman & Refreshment
        </h2>
        <% if (activeDrinks.length > 0) { %>
          <div class="product-grid" style="grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));">
            <% for (const p of activeDrinks) { %>
              <div class="product-card" data-cat="drinks">
                <span class="badge badge-green card-badge">MINUMAN</span>
                <a href="/product/<%= p.slug %>" class="product-thumb">
                  <img src="<%= p.image %>" alt="<%= p.name %>" loading="lazy">
                </a>
                <div class="product-info">
                  <h3 class="product-name"><a href="/product/<%= p.slug %>"><%= p.name %></a></h3>
                  <p class="product-desc"><%= p.description %></p>
                  <div class="product-footer">
                    <div class="product-price"><%= formatRupiah(p.price) %></div>
                    <div style="display: flex; gap: 8px;">
                      <a href="/product/<%= p.slug %>" class="btn btn-outline btn-sm">Detail</a>
                      <button type="button" class="btn btn-primary btn-sm"
                        onclick="Cart.add({ id: <%= p.id %>, type: 'product', name: '<%= p.name.replace(/'/g, "\\'") %>', price: <%= p.price %>, quantity: 1, image: '<%= p.image %>' })">
                        + Tambah
                      </button>
                    </div>
                  </div>
                </div>
              </div>
            <% } %>
          </div>
        <% } else { %>
          <div class="card"
            style="text-align: center; padding: 40px 20px; background: #FFF8F0; border: 1.5px dashed var(--border-color);">
            <div style="font-size: 48px; margin-bottom: 12px;">🥤❄️</div>
            <span class="badge badge-yellow" style="font-size: 13px; margin-bottom: 10px;">COMING SOON</span>
            <h3 style="font-size: 22px; color: var(--text-dark); margin-bottom: 8px;">Menu Minuman Segera Hadir!</h3>
            <p style="color: var(--text-muted); font-size: 14px; max-width: 450px; margin: 0 auto;">
              Menu minuman dingin yang segar pelepas dahaga sedang dalam proses persiapan dan akan segera hadir menemani
              pizza cone kamu!
            </p>
          </div>
        <% } %>
      </div>

    </div>
  </main>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const tabs = document.querySelectorAll('.cat-btn');
      const sections = document.querySelectorAll('.cat-section');
      const validCats = new Set(['all', 'nachos', 'snacks', 'bundling', 'drinks']);

      function syncNavActive(cat) {
        const isBundling = cat === 'bundling';
        document.querySelectorAll('[data-nav="menu"]').forEach(el => el.classList.toggle('active', !isBundling));
        document.querySelectorAll('[data-nav="bundling"]').forEach(el => el.classList.toggle('active', isBundling));
      }

      function filterCat(cat) {
        const target = validCats.has(cat) ? cat : 'all';
        tabs.forEach(t => {
          const isActive = t.dataset.cat === target;
          t.className = isActive ? 'btn btn-primary btn-sm cat-btn active' : 'btn btn-outline btn-sm cat-btn';
          t.setAttribute('aria-selected', isActive ? 'true' : 'false');
        });

        sections.forEach(sec => {
          sec.style.display = (target === 'all' || sec.id === 'cat-' + target) ? 'block' : 'none';
        });

        syncNavActive(target);
      }

      function applyHash() {
        const hashCat = window.location.hash.replace('#', '');
        filterCat(hashCat || 'all');
      }

      tabs.forEach(t => {
        t.addEventListener('click', () => {
          filterCat(t.dataset.cat);
          if (t.dataset.cat !== 'all') {
            history.replaceState(null, '', '#' + t.dataset.cat);
          } else {
            history.replaceState(null, '', window.location.pathname);
          }
        });
      });

      window.addEventListener('hashchange', applyHash);

      document.querySelectorAll('a[href="/menu#bundling"]').forEach(link => {
        link.addEventListener('click', (e) => {
          e.preventDefault();
          history.replaceState(null, '', '#bundling');
          filterCat('bundling');
          document.getElementById('cat-bundling')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      });

      document.querySelectorAll('a[href="/menu"]').forEach(link => {
        link.addEventListener('click', (e) => {
          e.preventDefault();
          history.replaceState(null, '', '/menu');
          filterCat('all');
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      });

      applyHash();
    });
  </script>

  <%- include('partials/footer') %>