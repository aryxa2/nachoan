<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" type="image/jpeg" href="/images/logo.jpg">
</head>
<body>

<div class="admin-layout">
  <%- include('sidebar') %>

  <main class="admin-main">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; flex-wrap: wrap; gap: 16px;">
      <div>
        <h1 style="font-size: 26px; color: var(--text-dark);">Kelola Promo & Diskon</h1>
        <p style="color: var(--text-muted); font-size: 14px;">Atur kupon voucher, diskon persentase, nominal tetap, dan hadiah otomatis.</p>
      </div>

      <button type="button" class="btn btn-primary btn-sm" onclick="document.getElementById('add-promo-modal').style.display='block'">
        + Tambah Promo Baru
      </button>
    </div>

    <!-- Flash message -->
    <% if (typeof req !== 'undefined' && req.query) { %>
      <% if (req.query.msg === 'updated') { %>
        <div style="background: #dcfce7; border: 1px solid #86efac; color: #166534; padding: 12px 16px; border-radius: var(--radius-sm); margin-bottom: 20px; font-weight: 700;">
          ✔ Promo berhasil diperbarui dan disinkronkan!
        </div>
      <% } else if (req.query.msg === 'created') { %>
        <div style="background: #dcfce7; border: 1px solid #86efac; color: #166534; padding: 12px 16px; border-radius: var(--radius-sm); margin-bottom: 20px; font-weight: 700;">
          ✔ Promo baru berhasil ditambahkan!
        </div>
      <% } %>
    <% } %>

    <!-- Promos Table -->
    <div class="card" style="padding: 20px;">
      <div class="table-responsive">
        <table class="custom-table">
          <thead>
            <tr>
              <th>Kode Promo</th>
              <th>Tipe</th>
              <th>Nilai Diskon</th>
              <th>Min. Belanja</th>
              <th>Deskripsi</th>
              <th>Status</th>
              <th>Aksi</th>
            </tr>
          </thead>
          <tbody>
            <% for (const p of promos) { %>
              <tr>
                <td>
                  <strong style="font-family: monospace; font-size: 15px; color: var(--primary);"><%= p.code %></strong>
                </td>
                <td>
                  <span class="badge <%= p.type === 'percentage' ? 'badge-red' : (p.type === 'fixed' ? 'badge-yellow' : 'badge-green') %>">
                    <%= p.type.toUpperCase() %>
                  </span>
                </td>
                <td>
                  <% if (p.type === 'percentage') { %>
                    <strong><%= p.value %>%</strong>
                  <% } else if (p.type === 'fixed') { %>
                    <strong><%= formatRupiah(p.value) %></strong>
                  <% } else { %>
                    <span>Gratis Item</span>
                  <% } %>
                </td>
                <td>
                  <%= p.min_purchase > 0 ? formatRupiah(p.min_purchase) : 'Tanpa Min.' %>
                </td>
                <td><span style="font-size: 13px; color: var(--text-muted);"><%= p.description %></span></td>
                <td>
                  <span class="badge <%= p.active ? 'badge-green' : 'badge-red' %>">
                    <%= p.active ? 'Aktif' : 'Nonaktif' %>
                  </span>
                </td>
                <td>
                  <div style="display: flex; gap: 6px; align-items: center;">
                    <!-- Edit Button -->
                    <button type="button" class="btn btn-outline btn-sm" style="padding: 4px 10px; font-size: 12px; border-color: #2563eb; color: #2563eb;"
                      onclick='openEditPromoModal(<%= JSON.stringify(p) %>)'>
                      ✏️ Edit
                    </button>
                    <!-- Toggle Active -->
                    <form action="/admin/promos/<%= p.id %>/toggle" method="POST" style="display: inline;">
                      <button type="submit" class="btn btn-outline btn-sm" style="padding: 4px 10px; font-size: 12px;">
                        <%= p.active ? 'Nonaktifkan' : 'Aktifkan' %>
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </main>
</div>

<!-- Modal Add Promo -->
<div id="add-promo-modal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 9999; overflow-y: auto; padding: 40px 10px;">
  <div style="background: var(--white); max-width: 480px; margin: 0 auto; border-radius: var(--radius-md); padding: 28px; box-shadow: 0 10px 30px rgba(0,0,0,0.3);">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
      <h3 style="font-size: 20px; color: var(--primary);">Tambah Promo Baru</h3>
      <button type="button" onclick="document.getElementById('add-promo-modal').style.display='none'" style="border: none; background: none; font-size: 20px; cursor: pointer;">&times;</button>
    </div>

    <form action="/admin/promos/new" method="POST">
      <div class="form-group">
        <label class="form-label">Kode Promo (Huruf Kapital) *</label>
        <input type="text" name="code" class="form-control" placeholder="Contoh: MERDEKA17" style="text-transform: uppercase;" required>
      </div>

      <div class="form-group">
        <label class="form-label">Tipe Diskon *</label>
        <select name="type" class="form-control" required id="promo-type-select" onchange="onPromoTypeChange('add')">
          <option value="percentage">Persentase (%)</option>
          <option value="fixed">Nominal Tetap (Rp)</option>
          <option value="gift">Hadiah Gratis (Free Gift)</option>
        </select>
      </div>

      <div class="form-group" id="promo-value-group">
        <label class="form-label" id="promo-val-label">Nilai Diskon (%):</label>
        <input type="number" name="value" class="form-control" placeholder="Contoh: 10">
      </div>

      <div class="form-group" id="promo-gift-group" style="display: none;">
        <label class="form-label">Pilih Item Gratis:</label>
        <select name="gift_product_id" class="form-control">
          <% for (const p of products) { %>
            <option value="<%= p.id %>"><%= p.name %></option>
          <% } %>
        </select>
      </div>

      <div class="form-group">
        <label class="form-label">Minimal Belanja (Rp):</label>
        <input type="number" name="min_purchase" class="form-control" placeholder="0 jika tanpa syarat" value="0">
      </div>

      <div class="form-group">
        <label class="form-label">Deskripsi Promo</label>
        <input type="text" name="description" class="form-control" placeholder="Contoh: Diskon 10% untuk semua menu">
      </div>

      <div style="display: flex; justify-content: flex-end; gap: 10px; margin-top: 24px;">
        <button type="button" class="btn btn-outline btn-sm" onclick="document.getElementById('add-promo-modal').style.display='none'">
          Batal
        </button>
        <button type="submit" class="btn btn-primary btn-sm">
          Simpan Promo
        </button>
      </div>
    </form>
  </div>
</div>

<!-- Modal Edit Promo -->
<div id="edit-promo-modal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 9999; overflow-y: auto; padding: 40px 10px;">
  <div style="background: var(--white); max-width: 480px; margin: 0 auto; border-radius: var(--radius-md); padding: 28px; box-shadow: 0 10px 30px rgba(0,0,0,0.3);">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
      <h3 style="font-size: 20px; color: var(--primary);">Edit Promo</h3>
      <button type="button" onclick="document.getElementById('edit-promo-modal').style.display='none'" style="border: none; background: none; font-size: 20px; cursor: pointer;">&times;</button>
    </div>

    <form id="edit-promo-form" action="" method="POST">
      <div class="form-group">
        <label class="form-label">Kode Promo (Huruf Kapital) *</label>
        <input type="text" name="code" id="edit-promo-code" class="form-control" style="text-transform: uppercase;" required>
      </div>

      <div class="form-group">
        <label class="form-label">Tipe Diskon *</label>
        <select name="type" id="edit-promo-type" class="form-control" required onchange="onPromoTypeChange('edit')">
          <option value="percentage">Persentase (%)</option>
          <option value="fixed">Nominal Tetap (Rp)</option>
          <option value="gift">Hadiah Gratis (Free Gift)</option>
        </select>
      </div>

      <div class="form-group" id="edit-promo-value-group">
        <label class="form-label" id="edit-promo-val-label">Nilai Diskon (%):</label>
        <input type="number" name="value" id="edit-promo-value" class="form-control">
      </div>

      <div class="form-group" id="edit-promo-gift-group" style="display: none;">
        <label class="form-label">Pilih Item Gratis:</label>
        <select name="gift_product_id" id="edit-promo-gift-id" class="form-control">
          <% for (const p of products) { %>
            <option value="<%= p.id %>"><%= p.name %></option>
          <% } %>
        </select>
      </div>

      <div class="form-group">
        <label class="form-label">Minimal Belanja (Rp):</label>
        <input type="number" name="min_purchase" id="edit-promo-min" class="form-control" value="0">
      </div>

      <div class="form-group">
        <label class="form-label">Status Keaktifan</label>
        <select name="active" id="edit-promo-active" class="form-control">
          <option value="1">Aktif</option>
          <option value="0">Nonaktif</option>
        </select>
      </div>

      <div class="form-group">
        <label class="form-label">Deskripsi Promo</label>
        <input type="text" name="description" id="edit-promo-desc" class="form-control">
      </div>

      <div style="display: flex; justify-content: flex-end; gap: 10px; margin-top: 24px;">
        <button type="button" class="btn btn-outline btn-sm" onclick="document.getElementById('edit-promo-modal').style.display='none'">
          Batal
        </button>
        <button type="submit" class="btn btn-primary btn-sm">
          Simpan Perubahan
        </button>
      </div>
    </form>
  </div>
</div>

<script>
function onPromoTypeChange(prefix = 'add') {
  const typeSelect = prefix === 'edit' ? document.getElementById('edit-promo-type') : document.getElementById('promo-type-select');
  const valGroup = prefix === 'edit' ? document.getElementById('edit-promo-value-group') : document.getElementById('promo-value-group');
  const giftGroup = prefix === 'edit' ? document.getElementById('edit-promo-gift-group') : document.getElementById('promo-gift-group');
  const valLabel = prefix === 'edit' ? document.getElementById('edit-promo-val-label') : document.getElementById('promo-val-label');

  const type = typeSelect.value;
  if (type === 'percentage') {
    valGroup.style.display = 'block';
    giftGroup.style.display = 'none';
    valLabel.textContent = 'Nilai Diskon (%):';
  } else if (type === 'fixed') {
    valGroup.style.display = 'block';
    giftGroup.style.display = 'none';
    valLabel.textContent = 'Nominal Potongan (Rp):';
  } else {
    valGroup.style.display = 'none';
    giftGroup.style.display = 'block';
  }
}

function openEditPromoModal(p) {
  const form = document.getElementById('edit-promo-form');
  form.action = '/admin/promos/' + p.id + '/edit';

  document.getElementById('edit-promo-code').value = p.code || '';
  document.getElementById('edit-promo-type').value = p.type || 'percentage';
  document.getElementById('edit-promo-value').value = p.value || 0;
  document.getElementById('edit-promo-min').value = p.min_purchase || 0;
  document.getElementById('edit-promo-active').value = p.active ? '1' : '0';
  document.getElementById('edit-promo-desc').value = p.description || '';
  if (p.gift_product_id) {
    document.getElementById('edit-promo-gift-id').value = p.gift_product_id;
  }

  onPromoTypeChange('edit');
  document.getElementById('edit-promo-modal').style.display = 'block';
}
</script>

</body>
</html>
