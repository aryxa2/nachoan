<%- include('partials/header') %>

<div style="background: #FFE8D6; padding: 28px 0; border-bottom: 1px solid var(--border-color);">
  <div class="container" style="text-align: center;">
    <h1 style="font-size: 32px; color: var(--primary); margin-bottom: 6px;">Promo & Bundling Spesial</h1>
    <p style="color: var(--text-muted); font-size: 15px;">Makan enak makin hemat dengan berbagai promo dan diskon eksklusif!</p>
  </div>
</div>

<main class="section">
  <div class="container">
    <!-- Promo Banner -->
    <div style="background: linear-gradient(135deg, #C1121F 0%, #8B0E13 100%); border-radius: var(--radius-lg); padding: 32px; color: var(--white); margin-bottom: 36px; box-shadow: var(--shadow);">
      <div style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 20px;">
        <div style="max-width: 600px;">
          <span style="background: var(--secondary); color: var(--text-dark); font-weight: 800; font-size: 12px; padding: 4px 12px; border-radius: 9999px; text-transform: uppercase;">
            DISKON SPESIAL HARI INI
          </span>
          <h2 style="font-size: 28px; margin: 12px 0 8px; color: var(--secondary);">Makan Enak Makin Hemat dengan NACHO10!</h2>
          <p style="font-size: 15px; font-weight: 600; opacity: 0.95;">
            Nikmati gurihnya <strong>Beefy Nacho</strong> dan manis gurihnya <strong>Cheezy Corn</strong> dengan diskon langsung 10% menggunakan kode kupon <strong>NACHO10</strong> saat checkout!
          </p>
        </div>
        <a href="/menu" class="btn btn-secondary" style="padding: 14px 28px;">
          Pesan Menu Sekarang &rsaquo;
        </a>
      </div>
    </div>

    <!-- Voucher Codes Grid -->
    <h2 style="font-size: 24px; margin-bottom: 20px;">Kupon & Kode Promo Tersedia</h2>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px; margin-bottom: 40px;">
      
      <div class="card" style="border-left: 6px solid var(--primary); display: flex; flex-direction: column; justify-content: space-between;">
        <div>
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
            <span class="badge badge-red" style="font-size: 14px; letter-spacing: 1px;">NACHO10</span>
            <span style="font-size: 13px; color: var(--accent-green); font-weight: 700;">● Aktif</span>
          </div>
          <h3 style="font-size: 20px; margin-bottom: 6px;">Diskon 10% Semua Menu</h3>
          <p style="color: var(--text-muted); font-size: 14px; line-height: 1.5; margin-bottom: 16px;">
            Dapatkan potongan diskon 10% untuk seluruh pesanan tanpa syarat minimum belanja.
          </p>
        </div>
        <div style="display: flex; align-items: center; justify-content: space-between; background: #FFF3E4; padding: 8px 14px; border-radius: var(--radius-sm);">
          <code style="font-weight: 800; font-size: 15px; color: var(--primary);">NACHO10</code>
          <button type="button" class="btn btn-outline btn-sm" onclick="copyToClipboard('NACHO10', 'Kode NACHO10 berhasil disalin!')">
            Salin Kode
          </button>
        </div>
      </div>

      <div class="card" style="border-left: 6px solid var(--accent-orange); display: flex; flex-direction: column; justify-content: space-between;">
        <div>
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
            <span class="badge badge-yellow" style="font-size: 14px; letter-spacing: 1px;">HEMAT5</span>
            <span style="font-size: 13px; color: var(--accent-green); font-weight: 700;">● Aktif</span>
          </div>
          <h3 style="font-size: 20px; margin-bottom: 6px;">Potongan Rp5.000</h3>
          <p style="color: var(--text-muted); font-size: 14px; line-height: 1.5; margin-bottom: 16px;">
            Potongan langsung Rp5.000 dengan minimal pembelanjaan keranjang Rp50.000.
          </p>
        </div>
        <div style="display: flex; align-items: center; justify-content: space-between; background: #FFF3E4; padding: 8px 14px; border-radius: var(--radius-sm);">
          <code style="font-weight: 800; font-size: 15px; color: var(--accent-orange);">HEMAT5</code>
          <button type="button" class="btn btn-outline btn-sm" onclick="copyToClipboard('HEMAT5', 'Kode HEMAT5 berhasil disalin!')">
            Salin Kode
          </button>
        </div>
      </div>

    </div>

    <!-- Bundling Highlight -->
    <div style="text-align: center; margin-top: 40px;">
      <h2 style="font-size: 24px; margin-bottom: 12px;">Ingin Paket Langsung Komplit?</h2>
      <p style="color: var(--text-muted); margin-bottom: 24px;">Nikmati paket Movie Night Combo dan Duo Pedas dengan porsi pas dan harga hemat!</p>
      <a href="/menu#bundling" class="btn btn-primary" style="padding: 12px 32px;">
        Lihat Menu Bundling &rsaquo;
      </a>
    </div>

  </div>
</main>

<%- include('partials/footer') %>
