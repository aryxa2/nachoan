<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'NACHOAN' %></title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" type="image/jpeg" href="/images/logo.jpg">
</head>
<body>

<header class="site-header">
  <div class="container">
    <div class="nav-wrap">
      <!-- Logo -->
      <a href="/" class="logo-link">
        <img src="/images/logo.jpg" alt="NACHOAN" class="logo-img">
      </a>

      <!-- Desktop Navigation -->
      <nav class="nav-links" aria-label="Navigasi Utama">
        <a href="/" class="nav-link <%= path === '/' ? 'active' : '' %>">Home</a>
        <a href="/about" class="nav-link <%= path === '/about' ? 'active' : '' %>">About</a>
        <a href="/menu" class="nav-link <%= path === '/menu' ? 'active' : '' %>" data-nav="menu">Menu</a>
        <a href="/menu#bundling" class="nav-link <%= path === '/bundling' ? 'active' : '' %>" data-nav="bundling">Bundling</a>
      </nav>

      <!-- Actions -->
      <div class="header-actions">
        <a href="/checkout" class="cart-btn-nav" title="Keranjang Belanja" aria-label="Keranjang Belanja">
          🛒
          <span class="cart-badge" style="display: none;">0</span>
        </a>

        <button type="button" class="mobile-toggle" id="mobile-toggle-btn" aria-label="Buka Menu Navigasi" aria-expanded="false" aria-controls="mobile-menu">
          ☰
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Menu Dropdown -->
  <nav class="mobile-menu" id="mobile-menu" aria-label="Navigasi Mobile">
    <a href="/" class="nav-link <%= path === '/' ? 'active' : '' %>">Home</a>
    <a href="/about" class="nav-link <%= path === '/about' ? 'active' : '' %>">About</a>
    <a href="/menu" class="nav-link <%= path === '/menu' ? 'active' : '' %>" data-nav="menu">Menu</a>
    <a href="/menu#bundling" class="nav-link <%= path === '/bundling' ? 'active' : '' %>" data-nav="bundling">Bundling</a>
    <a href="/checkout" class="nav-link" style="color: var(--primary);">🛒 Keranjang Belanja</a>
  </nav>
</header>
