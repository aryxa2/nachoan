<%- include('partials/header') %>

<main class="section">
  <div class="container">
    <div style="margin-bottom: 20px;">
      <a href="/menu#bundling" style="font-weight: 700; color: var(--primary); display: inline-flex; align-items: center; gap: 6px;">
        &lsaquo; Kembali ke Paket Bundling
      </a>
    </div>

    <div class="card" style="display: grid; grid-template-columns: 1fr; gap: 32px; padding: 32px;">
      <div style="display: grid; grid-template-columns: 1fr; gap: 32px;" class="detail-grid">
        <!-- Image -->
        <div style="background: #FFF8F0; border-radius: var(--radius-md); overflow: hidden; max-height: 400px; display: flex; align-items: center; justify-content: center; border: 1px solid var(--border-color);">
          <img src="<%= bundle.image %>" alt="<%= bundle.name %>" style="max-height: 100%; object-fit: contain;">
        </div>

        <!-- Info & Components -->
        <div style="display: flex; flex-direction: column;">
          <span class="badge badge-yellow" style="width: fit-content; margin-bottom: 8px;">PAKET COMBO HEMAT</span>
          <h1 style="font-size: 32px; color: var(--text-dark); margin-bottom: 8px;"><%= bundle.name %></h1>
          
          <div style="display: flex; align-items: baseline; gap: 10px; margin-bottom: 16px;">
            <% if (bundle.compare_price) { %>
              <span style="font-size: 18px; text-decoration: line-through; color: var(--text-muted); font-weight: 600;">
                <%= formatRupiah(bundle.compare_price) %>
              </span>
              <span class="badge badge-green">Hemat <%= formatRupiah(bundle.compare_price - bundle.price) %></span>
            <% } %>
            <span style="font-size: 28px; font-weight: 800; color: var(--primary);">
              <%= formatRupiah(bundle.price) %>
            </span>
          </div>

          <p style="color: var(--text-muted); font-size: 15px; line-height: 1.6; margin-bottom: 20px;">
            <%= bundle.description %>
          </p>

          <!-- Component Items Included -->
          <div style="background: #FFF3E4; padding: 18px; border-radius: var(--radius-sm); border: 1px solid var(--border-color); margin-bottom: 24px;">
            <div style="font-weight: 700; font-size: 14px; margin-bottom: 10px; color: var(--text-dark);">
              📦 Isi Paket yang Didapat:
            </div>
            <ul style="list-style: none; display: flex; flex-direction: column; gap: 8px;">
              <% for (const item of items) { %>
                <li style="display: flex; align-items: center; gap: 8px; font-size: 14px;">
                  <span style="color: var(--accent-green); font-weight: bold;">✔</span>
                  <strong><%= item.quantity %>×</strong> <%= item.name %>
                </li>
              <% } %>
            </ul>
          </div>

          <form id="add-bundle-form">
            <div style="margin-bottom: 24px;">
              <label class="form-label">Jumlah Paket:</label>
              <div style="display: inline-flex; align-items: center; border: 1.5px solid var(--border-color); border-radius: var(--radius-full); background: var(--white); overflow: hidden;">
                <button type="button" id="btn-minus" style="width: 40px; height: 40px; border: none; background: none; font-size: 20px; font-weight: bold; cursor: pointer;">-</button>
                <input type="number" id="qty-input" value="1" min="1" max="20" style="width: 50px; text-align: center; border: none; font-weight: 700; font-size: 16px;" readonly>
                <button type="button" id="btn-plus" style="width: 40px; height: 40px; border: none; background: none; font-size: 20px; font-weight: bold; cursor: pointer;">+</button>
              </div>
            </div>

            <button type="submit" class="btn btn-primary" style="padding: 14px 32px; font-size: 16px; width: 100%; max-width: 320px;">
              🍿 Tambah Paket ke Keranjang
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>
</main>

<style>
@media (min-width: 768px) {
  .detail-grid {
    grid-template-columns: 1fr 1fr !important;
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const qtyInput = document.getElementById('qty-input');
  const btnMinus = document.getElementById('btn-minus');
  const btnPlus = document.getElementById('btn-plus');
  const form = document.getElementById('add-bundle-form');

  btnMinus.addEventListener('click', () => {
    let val = parseInt(qtyInput.value, 10);
    if (val > 1) qtyInput.value = val - 1;
  });

  btnPlus.addEventListener('click', () => {
    let val = parseInt(qtyInput.value, 10);
    qtyInput.value = val + 1;
  });

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const qty = parseInt(qtyInput.value, 10) || 1;

    Cart.add({
      id: <%= bundle.id %>,
      type: 'bundle',
      name: '<%= bundle.name %>',
      price: <%= bundle.price %>,
      quantity: qty,
      image: '<%= bundle.image %>'
    });
  });
});
</script>

<%- include('partials/footer') %>
