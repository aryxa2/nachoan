<%- include('partials/header') %>

<!-- Hero Section -->
<section class="hero-section">
  <div class="container">
    <div class="hero-grid">
      <div class="hero-content">
        <span class="hero-tag">Pizza Cone Tortilla</span>
        <h1 class="hero-title">
          YOUR CRUNCH,<br>
          <span>YOUR WAY.</span>
        </h1>
        <p class="hero-desc">
          Your favorite pizza crunchy moment starts here. Nikmati kelezatan <strong>pizza</strong> dalam bentuk cone praktis anti-ribet!
        </p>
        <div class="hero-buttons">
          <a href="/menu" class="btn btn-primary" style="font-size: 16px; padding: 14px 28px;">
            PESAN SEKARANG
          </a>
          <a href="/about" class="btn btn-outline" style="font-size: 16px; padding: 14px 28px;">
            TENTANG NACHOAN
          </a>
        </div>
      </div>
      <div class="hero-visual">
        <% if (typeof heroSlides !== 'undefined' && heroSlides && heroSlides.length > 0) { %>
          <div class="hero-carousel" id="heroCarousel">
            <div class="hero-carousel-track-wrapper">
              <div class="hero-carousel-track" id="heroTrack">
                <% heroSlides.forEach((slide, index) => { %>
                  <div class="hero-carousel-slide">
                    <img src="<%= slide.image_url %>" alt="<%= slide.title || 'NACHOAN' %>">
                    <% if (slide.title || slide.caption) { %>
                      <div class="hero-carousel-caption">
                        <% if (slide.title) { %><h4><%= slide.title %></h4><% } %>
                        <% if (slide.caption) { %><p><%= slide.caption %></p><% } %>
                      </div>
                    <% } %>
                  </div>
                <% }); %>
              </div>
            </div>

            <% if (heroSlides.length > 1) { %>
              <button type="button" class="hero-carousel-btn prev" id="heroPrevBtn" aria-label="Slide Sebelumnya">&#10094;</button>
              <button type="button" class="hero-carousel-btn next" id="heroNextBtn" aria-label="Slide Selanjutnya">&#10095;</button>

              <div class="hero-carousel-dots" id="heroDots">
                <% heroSlides.forEach((slide, index) => { %>
                  <button type="button" class="hero-carousel-dot <%= index === 0 ? 'active' : '' %>" data-index="<%= index %>" aria-label="Slide <%= index + 1 %>"></button>
                <% }); %>
              </div>
            <% } %>
          </div>
        <% } else { %>
          <img src="/images/products/beefy-nacho.jpg" alt="NACHOAN Cone Beefy Nacho" class="hero-cone-img" style="border-radius: 24px; max-height: 440px; box-shadow: 0 15px 30px rgba(193, 18, 31, 0.2);">
        <% } %>
      </div>
    </div>
  </div>
</section>


<% if (typeof bestSeller !== 'undefined' && bestSeller) { %>
<!-- Best Seller Section -->
<section class="section">
  <div class="container">
    <div class="section-header">
      <div>
        <h2 class="section-title">BEST SELLER 🔥</h2>
        <p class="section-subtitle">Menu terlaris pilihan pelanggan NACHOAN</p>
      </div>
      <a href="/menu" class="view-all-link">Lihat Menu &rsaquo;</a>
    </div>

    <article class="best-seller-spotlight">
      <a href="/product/<%= bestSeller.slug %>" class="spotlight-thumb">
        <img src="<%= bestSeller.image %>" alt="<%= bestSeller.name %>" loading="lazy">
      </a>
      <div class="spotlight-body">
        <div class="spotlight-badges">
          <span class="badge badge-yellow">#1 TERLARIS</span>
          <% if (typeof bestSellerSold !== 'undefined' && bestSellerSold >= 10) { %>
            <span class="badge badge-red"><%= bestSellerSold %>+ Terjual</span>
          <% } %>
        </div>
        <h3 class="spotlight-title">
          <a href="/product/<%= bestSeller.slug %>"><%= bestSeller.name %></a>
        </h3>
        <p class="spotlight-desc"><%= bestSeller.description %></p>
        <div class="spotlight-footer">
          <div class="spotlight-price-wrap">
            <span class="spotlight-price-label">Harga</span>
            <div class="product-price spotlight-price"><%= formatRupiah(bestSeller.price) %></div>
          </div>
          <div class="spotlight-actions">
            <button type="button" class="btn btn-primary spotlight-cta" onclick="Cart.add({ id: <%= bestSeller.id %>, type: 'product', name: '<%= bestSeller.name.replace(/\\/g, '\\\\').replace(/'/g, "\\'") %>', price: <%= bestSeller.price %>, quantity: 1, image: '<%= bestSeller.image %>' })">
              + Pesan Sekarang
            </button>
            <a href="/product/<%= bestSeller.slug %>" class="btn btn-outline spotlight-detail">
              Lihat Detail
            </a>
          </div>
        </div>
      </div>
    </article>
  </div>
</section>
<% } %>

<!-- Combo Bundling Banner -->
<section class="section" style="padding-top: 0;">
  <div class="container">
    <div class="promo-banner" style="background: linear-gradient(135deg, #1A1412 0%, #2B2118 100%);">
      <div>
        <h2 style="color: var(--secondary);">COMBO THAT HITS.</h2>
        <p>Paket combo hemat lengkap dengan minuman pendamping telah hadir untuk temani momen seru kamu!</p>
        <a href="/menu#bundling" class="btn btn-secondary promo-cta">
          Lihat Paket Bundling
        </a>
      </div>
      <div style="text-align: center;">
        <img src="/images/products/cheezy-corn.jpg" alt="Cheezy Corn" class="promo-thumb" style="border-radius: 18px; max-height: 220px;">
      </div>
    </div>
  </div>
</section>

<!-- Inovasi Kemasan Feature Banner -->
<section class="section" style="background: var(--white); border-top: 1px solid var(--border-color); border-bottom: 1px solid var(--border-color);">
  <div class="container">
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 28px; align-items: center;">
      <div style="text-align: center;">
        <img src="/images/cone.jpg" alt="Kemasan NACHOAN" style="max-height: 280px; margin: 0 auto; border-radius: 18px; box-shadow: 0 10px 20px rgba(0,0,0,0.1);">
      </div>
      <div>
        <span class="badge badge-red" style="margin-bottom: 10px;">DESIGN INOVATIF</span>
        <h2 style="font-size: 28px; color: var(--primary); margin-bottom: 12px;">Kemasan Anti-Tumpah</h2>
        <p style="color: var(--text-muted); font-size: 15px; margin-bottom: 18px; line-height: 1.6;">
          Didesain khusus berbentuk ergonomis. Praktis digenggam satu tangan, saus dan keju merata hingga dasar kemasan, dan tetap rapi saat dinikmati di mana saja!
        </p>
        <a href="/about#kemasan" class="btn btn-outline btn-sm">Pelajari Desain Kemasan</a>
      </div>
    </div>
  </div>
</section>

<script>
  (function() {
    const carousel = document.getElementById('heroCarousel');
    const track = document.getElementById('heroTrack');
    if (!carousel || !track) return;

    const slides = track.querySelectorAll('.hero-carousel-slide');
    const prevBtn = document.getElementById('heroPrevBtn');
    const nextBtn = document.getElementById('heroNextBtn');
    const dots = document.querySelectorAll('.hero-carousel-dot');
    const totalSlides = slides.length;
    if (totalSlides <= 1) return;

    let currentIndex = 0;
    let timer = null;

    function goToSlide(index) {
      if (index < 0) {
        currentIndex = totalSlides - 1;
      } else if (index >= totalSlides) {
        currentIndex = 0;
      } else {
        currentIndex = index;
      }

      track.style.transform = `translateX(-${currentIndex * 100}%)`;

      dots.forEach((dot, idx) => {
        if (idx === currentIndex) {
          dot.classList.add('active');
        } else {
          dot.classList.remove('active');
        }
      });
    }

    function nextSlide() {
      goToSlide(currentIndex + 1);
    }

    function prevSlide() {
      goToSlide(currentIndex - 1);
    }

    function startAutoSlide() {
      stopAutoSlide();
      timer = setInterval(nextSlide, 4500);
    }

    function stopAutoSlide() {
      if (timer) {
        clearInterval(timer);
        timer = null;
      }
    }

    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        prevSlide();
        startAutoSlide();
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        nextSlide();
        startAutoSlide();
      });
    }

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const targetIdx = parseInt(dot.getAttribute('data-index'), 10);
        goToSlide(targetIdx);
        startAutoSlide();
      });
    });

    carousel.addEventListener('mouseenter', stopAutoSlide);
    carousel.addEventListener('mouseleave', startAutoSlide);

    // Touch swipe support
    let startX = 0;
    let endX = 0;
    carousel.addEventListener('touchstart', (e) => {
      startX = e.changedTouches[0].screenX;
      stopAutoSlide();
    }, { passive: true });

    carousel.addEventListener('touchend', (e) => {
      endX = e.changedTouches[0].screenX;
      if (startX - endX > 40) {
        nextSlide();
      } else if (endX - startX > 40) {
        prevSlide();
      }
      startAutoSlide();
    }, { passive: true });

    startAutoSlide();
  })();
</script>

<%- include('partials/footer') %>
